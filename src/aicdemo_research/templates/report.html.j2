<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
:root{--navy:#16324f;--blue:#2f6b9a;--ink:#263444;--muted:#667085;--line:#d9e1e8;--pale:#eef4f8}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:#eef2f5;font-family:Arial,Helvetica,sans-serif;line-height:1.48}main{width:min(980px,calc(100% - 32px));margin:24px auto;background:#fff;box-shadow:0 12px 36px #24384a24}header{padding:42px 52px 30px;border-top:9px solid var(--navy);border-bottom:1px solid var(--line)}.kicker{color:var(--blue);font-size:12px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase}h1{margin:8px 0 10px;color:var(--navy);font-size:34px;line-height:1.12;letter-spacing:-.7px}.subtitle{color:var(--muted);font-size:13px}section{padding:30px 52px;border-bottom:1px solid var(--line)}h2{margin:0 0 16px;color:var(--navy);font-size:23px}h3{color:var(--navy);font-size:16px;margin:24px 0 8px}p{margin:0 0 13px;font-size:14px}.callout{border-left:4px solid var(--blue);background:var(--pale);padding:15px 18px;margin:16px 0}.figure-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:22px 0 8px}figure{margin:0;border:1px solid var(--line);padding:8px;background:white}figure.full{grid-column:1/-1}figure img{width:100%;height:auto;display:block}figcaption{color:var(--muted);font-size:11px;margin:5px 4px}table{width:100%;border-collapse:collapse;margin:12px 0 18px;font-size:11px;font-variant-numeric:tabular-nums}th{background:var(--navy);color:#fff;padding:7px 6px;text-align:right}td{padding:6px;border-bottom:1px solid var(--line);text-align:right}th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}tr:nth-child(even) td{background:#f7f9fb}.references li{margin-bottom:8px;font-size:12px;overflow-wrap:anywhere}.method-note{font-size:12px;color:var(--muted)}footer{padding:20px 52px 34px;color:var(--muted);font-size:11px}@media(max-width:720px){header,section,footer{padding-left:22px;padding-right:22px}.figure-grid{grid-template-columns:1fr}h1{font-size:27px}}@media print{body{background:white}main{width:auto;margin:0;box-shadow:none}section{break-inside:avoid}a{color:inherit;text-decoration:none}.figure-grid{break-inside:avoid}}
</style></head><body><main>
<header><div class="kicker">Fundamental Equity Research | Historical Analysis</div><h1>{{ title }}</h1><div class="subtitle">Apple Inc. (AAPL) and Microsoft Corporation (MSFT) | FY2022-FY2026 | Generated {{ generated_at }}</div></header>
{% for section in sections %}<section id="section-{{ loop.index }}"><h2>{{ loop.index }}. {{ section.title }}</h2>
{% if loop.index == 1 %}<div class="callout">{{ section.paragraphs[0] }}</div>{% for paragraph in section.paragraphs[1:] %}<p>{{ paragraph }}</p>{% endfor %}{% else %}{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}{% endif %}
{% if figures_by_section.get(loop.index) %}<div class="figure-grid">{% for figure in figures_by_section[loop.index] %}<figure class="{{ 'full' if figures_by_section[loop.index]|length == 1 else '' }}"><img src="{{ figure.src }}" alt="{{ figure.caption }}"><figcaption>{{ figure.caption }}</figcaption></figure>{% endfor %}</div>{% endif %}
{% if loop.index == 1 %}<h3>Latest Fiscal Year Scorecard</h3>{{ latest_table }}{% endif %}</section>{% endfor %}
<section><h2>Appendix A. Five-Year Core Financial Data</h2>{{ core_table }}</section>
<section><h2>Appendix B. Data Lineage and Verification</h2><p>All {{ verification_count }} raw observations were matched to consolidated, non-dimensional inline XBRL contexts in the corresponding original Form 10-K. Derived metrics were recalculated from unrounded values.</p><p class="method-note">Revenue growth = Revenue / prior-year Revenue - 1. Margins = relevant GAAP profit / Revenue. Free cash flow = Operating Cash Flow - cash purchases of property and equipment. Capex intensity = cash capital expenditures / Revenue.</p></section>
<section><h2>References</h2><ol class="references">{% for ref in references %}<li>{{ ref.html }}</li>{% endfor %}</ol></section>
<footer>Historical fundamental analysis only. This report does not contain valuation analysis, a target price or an investment recommendation.</footer>
</main></body></html>
